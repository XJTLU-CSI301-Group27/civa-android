<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
    android:paddingTop="36dp" android:paddingBottom="24dp">
    <TextView android:id="@+id/app_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/civa_text"
        android:textSize="30sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="@string/app_not_connected"
        android:textColor="@color/civa_muted" android:textSize="16sp" />
</LinearLayout>
