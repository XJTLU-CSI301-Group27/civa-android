<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal">
    <com.google.android.material.navigationrail.NavigationRailView android:id="@+id/app_navigation"
        android:layout_width="wrap_content" android:layout_height="match_parent"
        app:labelVisibilityMode="labeled" app:menu="@menu/app_navigation" />
    <androidx.fragment.app.FragmentContainerView android:id="@+id/app_content"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
</LinearLayout>
