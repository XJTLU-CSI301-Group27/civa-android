# Values here configure the PostgreSQL container. Set your own password in .env.
POSTGRES_DB=civa
POSTGRES_USER=civa
POSTGRES_PASSWORD=

# Set these separately in the shell that runs the server; Compose does not export them.
DB_URL=jdbc:postgresql://localhost:5432/civa
DB_USERNAME=civa
DB_PASSWORD=
CIVA_MEDIA_DIR=
SERVER_PORT=8080
